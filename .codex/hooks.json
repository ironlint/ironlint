{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"/Users/chrisarter/.config/ironlint/adapters/codex/hook.sh\" pre-tool-use",
            "statusMessage": "ironlint check",
            "timeout": 120,
            "type": "command"
          }
        ],
        "matcher": "apply_patch|Edit|Write|Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "if [ -d target/llvm-cov-target ] || [ -d target/llvm-cov ]; then echo 'coverage scratch present in target/ — run: rm -rf target/llvm-cov-target target/llvm-cov' >&2; exit 2; fi",
            "type": "command"
          }
        ]
      }
    ]
  }
}
