# Keep the Docker build context small for tests/e2e/. The adapter registry
# embeds files under adapters/. Keep Cargo.toml, Cargo.lock, crates/, adapters/.
target/
.git/
node_modules/
**/node_modules/
tests/e2e/*/runs/
.repowise/
.claude/
.ironlint/
*.profraw
.DS_Store
# Docs/specs/plans aren't needed by the build or runtime fixtures.
specs/
plans/
docs/
